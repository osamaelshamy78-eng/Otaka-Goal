# ESPN's public API serves the Champions League, Premier League, LaLiga, Serie A and
# the Saudi league with no key.

# Optional fallback for the four European competitions when ESPN fails.
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# API-Football key for the Egyptian and UAE leagues. https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Set to 1 to run the whole site on generated sample data instead.
SAMPLE_DATA=
